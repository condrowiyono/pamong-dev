---
// How It Works / Process Component
---

<section id="process" class="section bg-gray-50">
  <div class="container-wrapper">
    <div class="section-title">
      <h2>How We Work</h2>
      <p>Our proven process ensures your project succeeds at every stage</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Step 1 -->
      <div class="relative">
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-center w-14 h-14 rounded-full bg-blue-600 text-white font-bold text-xl">
            1
          </div>
          <h3 class="text-lg font-bold text-gray-900">Discovery</h3>
          <p class="text-gray-600">
            We deep dive into your business, goals, and vision to understand what success looks like.
          </p>
        </div>
        <!-- Connector line (hidden on mobile) -->
        <div class="hidden md:block absolute top-7 left-20 w-full h-1 bg-gradient-to-r from-blue-600 to-blue-200 -translate-y-full"></div>
      </div>

      <!-- Step 2 -->
      <div class="relative">
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-center w-14 h-14 rounded-full bg-blue-600 text-white font-bold text-xl">
            2
          </div>
          <h3 class="text-lg font-bold text-gray-900">Strategy & Design</h3>
          <p class="text-gray-600">
            We create a roadmap and design mockups to align on vision before writing a single line of code.
          </p>
        </div>
        <div class="hidden md:block absolute top-7 left-20 w-full h-1 bg-gradient-to-r from-blue-600 to-blue-200 -translate-y-full"></div>
      </div>

      <!-- Step 3 -->
      <div class="relative">
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-center w-14 h-14 rounded-full bg-blue-600 text-white font-bold text-xl">
            3
          </div>
          <h3 class="text-lg font-bold text-gray-900">Development</h3>
          <p class="text-gray-600">
            Using cutting-edge tech, we build your product with clean code, testing, and regular updates.
          </p>
        </div>
        <div class="hidden md:block absolute top-7 left-20 w-full h-1 bg-gradient-to-r from-blue-600 to-blue-200 -translate-y-full"></div>
      </div>

      <!-- Step 4 -->
      <div class="relative">
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-center w-14 h-14 rounded-full bg-blue-600 text-white font-bold text-xl">
            4
          </div>
          <h3 class="text-lg font-bold text-gray-900">Launch & Support</h3>
          <p class="text-gray-600">
            We deploy to production, monitor performance, and provide ongoing support to keep you running smoothly.
          </p>
        </div>
      </div>
    </div>

    <!-- Additional Info -->
    <div class="mt-16 bg-white rounded-lg p-8 border border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-blue-600 mb-2">2-4 weeks</div>
          <p class="text-gray-600">Average project kickoff to MVP</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-blue-600 mb-2">100%</div>
          <p class="text-gray-600">Transparent communication throughout</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-blue-600 mb-2">∞</div>
          <p class="text-gray-600">Long-term partnership & support</p>
        </div>
      </div>
    </div>
  </div>
</section>
