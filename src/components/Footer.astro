---
// Footer Component
---

<footer class="bg-gray-900 text-white">
  <div class="container-wrapper py-16 lg:py-20">
    <!-- Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand Column -->
      <div class="md:col-span-1">
        <div class="mb-4">
          <div class="text-2xl font-bold font-mono mb-2">{'{pamong}'}.dev</div>
          <div class="text-2xl text-blue-400">ꦥꦩꦺꦴꦁ</div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed">
          Your friendly tech partner, making the impossible possible through end-to-end development.
        </p>
      </div>

      <!-- Services Links -->
      <div>
        <h4 class="font-semibold mb-4">Services</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li><a href="#services" class="hover:text-blue-400 transition-colors">Full Stack Development</a></li>
          <li><a href="#services" class="hover:text-blue-400 transition-colors">Mobile Apps</a></li>
          <li><a href="#services" class="hover:text-blue-400 transition-colors">Design & UX</a></li>
          <li><a href="#services" class="hover:text-blue-400 transition-colors">Consulting</a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="font-semibold mb-4">Company</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li><a href="#" class="hover:text-blue-400 transition-colors">About Us</a></li>
          <li><a href="#portfolio" class="hover:text-blue-400 transition-colors">Portfolio</a></li>
          <li><a href="#" class="hover:text-blue-400 transition-colors">Blog</a></li>
          <li><a href="#" class="hover:text-blue-400 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="font-semibold mb-4">Get In Touch</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li>
            <a href="mailto:hello@pamong.dev" class="hover:text-blue-400 transition-colors">
              hello@pamong.dev
            </a>
          </li>
          <li>
            <a href="tel:+1234567890" class="hover:text-blue-400 transition-colors">
              +1 (234) 567-890
            </a>
          </li>
          <li class="text-gray-500">
            Available for new projects
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Copyright -->
      <p class="text-sm text-gray-400">
        &copy; 2024 Pamong.dev. All rights reserved.
      </p>

      <!-- Social Links -->
      <div class="flex items-center gap-6">
        <a href="#" class="text-gray-400 hover:text-blue-400 transition-colors" title="Twitter">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2s9 5 20 5a9.5 9.5 0 00-9-5.5c4.75 2.25 7-7 7-7z"></path>
          </svg>
        </a>
        <a href="#" class="text-gray-400 hover:text-blue-400 transition-colors" title="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a href="#" class="text-gray-400 hover:text-blue-400 transition-colors" title="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.544 2.914 1.181.092-.916.35-1.543.636-1.897-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
