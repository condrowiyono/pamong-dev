---
// Portfolio / Case Studies Component
---

<section id="portfolio" class="section bg-white">
  <div class="container-wrapper">
    <div class="section-title">
      <h2>Our Work</h2>
      <p>See how we've helped businesses bring their ideas to life</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Case Study 1 -->
      <div class="group cursor-pointer">
        <div class="relative overflow-hidden rounded-xl mb-6 bg-gradient-to-br from-blue-100 to-blue-50 h-72 flex items-center justify-center">
          <div class="text-center">
            <div class="text-6xl mb-4">📱</div>
            <p class="text-gray-600 font-medium">E-Commerce Mobile App</p>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-all duration-300"></div>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
          E-Commerce Platform
        </h3>
        <p class="text-gray-600 mb-4">
          Built a cross-platform mobile app for a retail startup, resulting in 3x user growth in 6 months.
        </p>
        <a href="#" class="link-arrow">
          Read Case Study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Case Study 2 -->
      <div class="group cursor-pointer">
        <div class="relative overflow-hidden rounded-xl mb-6 bg-gradient-to-br from-purple-100 to-purple-50 h-72 flex items-center justify-center">
          <div class="text-center">
            <div class="text-6xl mb-4">🏢</div>
            <p class="text-gray-600 font-medium">SaaS Dashboard</p>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-all duration-300"></div>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
          Analytics Dashboard
        </h3>
        <p class="text-gray-600 mb-4">
          Designed and built a real-time analytics dashboard for an enterprise client, handling millions of data points.
        </p>
        <a href="#" class="link-arrow">
          Read Case Study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Case Study 3 -->
      <div class="group cursor-pointer">
        <div class="relative overflow-hidden rounded-xl mb-6 bg-gradient-to-br from-green-100 to-green-50 h-72 flex items-center justify-center">
          <div class="text-center">
            <div class="text-6xl mb-4">🎨</div>
            <p class="text-gray-600 font-medium">Brand Redesign</p>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-all duration-300"></div>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
          Complete Brand Redesign
        </h3>
        <p class="text-gray-600 mb-4">
          Revamped the entire web experience for a fintech startup, improving conversions by 45% in 3 months.
        </p>
        <a href="#" class="link-arrow">
          Read Case Study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Case Study 4 -->
      <div class="group cursor-pointer">
        <div class="relative overflow-hidden rounded-xl mb-6 bg-gradient-to-br from-orange-100 to-orange-50 h-72 flex items-center justify-center">
          <div class="text-center">
            <div class="text-6xl mb-4">🚀</div>
            <p class="text-gray-600 font-medium">Startup MVP</p>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-all duration-300"></div>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
          Startup MVP Launch
        </h3>
        <p class="text-gray-600 mb-4">
          Rapid MVP development for a startup, from concept to Series A funding in just 8 weeks.
        </p>
        <a href="#" class="link-arrow">
          Read Case Study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
